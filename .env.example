# GitHub Actions supplies GITHUB_TOKEN automatically. Locally, it is optional
# but recommended to avoid the low anonymous API rate limit.
GITHUB_TOKEN=your_github_token_for_local_runs_only

MODEL_PROVIDER=openai
MODEL_API_KEY=your_model_api_key
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_qq_email@example.com
SMTP_AUTH_CODE=your_qq_smtp_authorization_code
DIGEST_TO=recipient@example.com

